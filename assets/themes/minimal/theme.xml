<!-- Theme: Minimal (IPOD/THEME 0, docs/ipod.md#display-settings). Its numbers (Home rows, the settings
     top, the progress bar, the scheme colours) come from patch/offsets.inc via tools/theme.py ROLE_MACROS. -->
<theme format="1" id="minimal" name="Minimal" index="0">
  <colorSchemes accents="graphite crimson tidal champagne cobalt tangerine plum ivory green"/>
  <colorScheme name="crimson" raw_red="1"/>  <!-- stock's own reds: the identity -->
  <colorScheme name="ivory" card="1"/>       <!-- the off-white card with dark ink -->
  <option setting="light" preset="off" keep="auto"/>
  <option setting="accent" key="MINIMAL_ACCENT" default="ivory" preset="graphite"/>
  <option setting="corners" preset="round"/>
  <option setting="home" preset="split"/>
  <option setting="shortcut"/>
  <option setting="battery"/>
  <option setting="time_title" preset="on"/>
  <option setting="np_layout"/>
  <view name="bar"><element name="title" caps="1"/></view>
  <view name="list">
    <element name="selection" painter="card"/>
    <element name="icons" mono="1" badge_muted="1" addon_mono="1"/>
  </view>
  <view name="home"><element name="chevron" visible="0"/><element name="rows" caps="1"/></view>
  <view name="playing" layout="ipod">
    <element name="art" square="0"/>
    <element name="title" font="regular"/>
    <element name="album" caps="1" opacity="0"/>
    <element name="state" opacity="0"/>
  </view>
  <!-- Cover Flow's shelf takes CF_* (ROLE_MACROS); the thumb is every theme's, Classic's and Modern's by extends:
       the wheel holds the covers (docs/internals.md#coverflow-thumb); these are its numbers, to retune on the wheel.
       jump_ms at jump_at ticks/s or more (72: 2 turns a second at 50% Wheel Sensitivity; a dip under it, still at fast_at,
       drains the count rather than dropping it), a spin goes by letters, one each jump_ticks of travel (jump_ticks 0:
       never), until a lift, a turn back, the rate under fast_at or no tick for stop_ms. -->
  <view name="coverflow">
    <element name="shelf" thumb="1" ticks_turn="36" ticks_album="7" fast_at="23" fast_full="90" top_speed="20" track="30"
             snap="25" spin="130" far_left="250" detent="80" hold_ms="5000" stop_ms="60" stop_left="60" rate_up="120"
             rate_down="50" back="50" dead="1" contact_ms="40" aim_snap="30" lead_from="25" lead_full="100" lead_ms="45"
             row_shift="20" row_from="100" row_full="300" row_shrink="8" row_flat="200" row_out="33" row_edge="160"
             row_width="60" row_key="72" row_reach="22" jump_ms="400" jump_ticks="5"
             jump_at="72"/>
  </view>
</theme>
