<!-- Theme: Modern (IPOD/THEME 2, docs/ipod.md#display-settings): the accent's bar over Minimal's layout. Its numbers (Home rows, the settings top, the progress bar, the scheme
     colours) come from patch/offsets.inc via tools/theme.py ROLE_MACROS. -->
<theme format="1" id="modern" name="现代" index="2" extends="minimal">
  <!-- The bar's battery draws at the set's batt_w x batt_h (navigation.c paint_battery): up from
     SET0's 16 x 11, so the icon reads beside the 16 px percentage instead of a size under it. -->
  <geometry name="modern" batt_w="20" batt_h="13"/>
  <geometry set="modern"/>
  <colorSchemes accents="graphite crimson tidal champagne cobalt tangerine plum green"/>
  <option key="STATUSBAR" label="状态栏外观" default="跟随主题" preset="跟随主题"><value label="跟随主题"/><value label="简约"/><value label="现代"/><value label="经典"/></option>
  <option setting="light" preset="on" keep="auto"/>
  <option setting="accent" key="ACCENT" default="graphite" preset="cobalt"/>
  <option setting="corners" preset="square"/>
  <option setting="home" preset="split"/>
  <option setting="shortcut"/>
  <option setting="battery"/>
  <option setting="time_title" preset="off"/>
  <option setting="np_layout"/>
  <view name="bar"><element name="title" caps="0"/></view>
  <view name="list">
    <element name="selection" painter="bar"/>
    <element name="icons" mono="0" badge_muted="0" addon_mono="0"/>
  </view>
  <view name="home"><element name="chevron" visible="1"/><element name="rows" caps="0"/></view>
  <view name="playing">
    <element name="art" square="1"/>
    <element name="title" font="bold"/>
    <element name="album" caps="0" opacity="255"/>
    <element name="state" opacity="255"/>
  </view>
</theme>
