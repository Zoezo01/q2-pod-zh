<!-- Theme: Nano (IPOD/THEME 2, docs/ipod.md#display-settings): an iPod nano (3rd generation) look on its
     own geometry sets (tools/ipod.py NANO, NANO_TEXT). dev="1": only a dev build offers it. Its numbers
     are this file's or the sets', never patch/offsets.inc's. -->
<theme format="1" id="nano" name="Nano" index="2" extends="classic" dev="1">
  <geometry set="nano"/>
  <!-- every scheme: white text on the band in both halves; the light half on white paper, black ink -->
  <colorScheme sel.text="#ffffff" light.paper="#ffffff" light.ink="#000000" light.sel.text="#ffffff"/>
  <!-- Nano Blue: Cobalt's tones and the measured band: its 1 px top line, the stops below it, its edge. Hues, so its
       light half is the same. The other accents get this band turned to their own top tone -->
  <colorScheme name="nano-blue" label="Nano Blue" base="cobalt" sel.top="#94c7de"
               sel.stops="#08a6e7 0, #009ade 17, #008ade 38, #007dde 58, #006dd6 79, #0065d6 100"
               sel.edge="#004184"/>
  <colorSchemes accents="nano-blue graphite crimson tidal champagne cobalt tangerine plum green" derive="gloss"/>
  <!-- Nano's face: list rows (title 18 px), the bar title (15 px), the Now Playing title and Home rows -->
  <view name="list">
    <element name="selection" painter="stops"/>
    <element name="row" font="nano" meta_font="nano" title_px="18"/>
  </view>
  <view name="bar"><element name="title" font="nano" font_size="15"/></view>
  <view name="playing"><element name="title" font="nano"/></view>
  <!-- Light Mode: On is the measured nano look, Off its dark half, Auto both by the clock -->
  <option setting="light" preset="on" keep="auto"/>
  <option setting="accent" key="NANO_ACCENT" default="nano-blue" preset="nano-blue"/>
  <option setting="home"/>
  <option setting="shortcut"/>
  <option setting="battery"/>
  <option setting="time_title" preset="on"/>
  <!-- Row Art, Nano's own option: On shows the art lists' covers and icons in 52 px rows (the nano set),
       Off makes every list 28 px text (nano-text). A change restarts the Q2. Choosing Nano presets
       On, as Classic presets Cobalt. -->
  <option key="ROWART" label="Row Art" default="On" preset="On">
    <value label="Off" set="nano-text"/>
    <value label="On" set="nano"/>
  </option>
</theme>
