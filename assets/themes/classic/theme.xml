<!-- Theme: Classic (IPOD/THEME 1, docs/ipod.md#display-settings). Its numbers (Home rows, the settings
     top, the progress bar, the scheme colours) come from patch/offsets.inc via tools/theme.py ROLE_MACROS. -->
<theme format="1" id="classic" name="Classic" index="1" extends="minimal">
  <colorSchemes accents="graphite crimson tidal champagne cobalt tangerine plum green"/>
  <option setting="light" preset="on" keep="auto"/>
  <option setting="accent" key="ACCENT" default="graphite" preset="cobalt"/>
  <option setting="corners" preset="square"/>
  <option setting="home" preset="split"/>
  <option setting="shortcut"/>
  <option setting="battery"/>
  <option setting="time_title" preset="off"/>
  <option setting="np_layout"/>
  <view name="bar"><element name="title" caps="0"/></view>
  <view name="list">
    <element name="selection" painter="bar"/>
    <element name="icons" mono="0" badge_muted="0" addon_mono="0"/>
  </view>
  <view name="home"><element name="chevron" visible="1"/><element name="rows" caps="0"/></view>
  <view name="playing">
    <element name="art" square="1"/>
    <element name="title" font="bold"/>
    <element name="album" caps="0" opacity="255"/>
    <element name="state" opacity="255"/>
  </view>
</theme>
